{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/heracles/branch-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/heracles/check-docs-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
